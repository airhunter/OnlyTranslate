:8080 {
	root * /srv

	encode zstd gzip

	@skipUninstallFeedback {
		not {
			path /uninstall/thanks /en/uninstall/thanks /zh-tw/uninstall/thanks /ja/uninstall/thanks
			query reason=*
		}
	}
	log_skip @skipUninstallFeedback
	log {
		output file /var/log/caddy/submissions.json {
			mode 0600
			roll_at 00:00
			roll_size 10MiB
			roll_uncompressed
			roll_keep 90
			roll_keep_for 2160h
		}
		format filter {
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
			request>proto delete
			request>method delete
			request>host delete
			request>headers delete
			request>tls delete
			bytes_read delete
			user_id delete
			duration delete
			size delete
			resp_headers delete
		}
	}

	@uninstallReport path /internal/uninstall-report /internal/uninstall-report/*
	header @uninstallReport {
		Cache-Control "no-store"
		X-Robots-Tag "noindex, nofollow, noarchive"
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	@documents {
		not path /assets/* /internal/uninstall-report*
	}
	header @documents Cache-Control "no-cache"

	handle_path /internal/uninstall-report/data/* {
		root * /var/log/caddy
		file_server browse
	}

	header {
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
	}

	try_files {path} {path}.html {path}/index.html
	file_server

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
