{
  "name": "只译",
  "description": "给认真读外语内容的人：网页、视频字幕、EPUB 和 PDF 都能双语翻译。",
  "private": true,
  "version": "1.9.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "vue-tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:content": "vitest run tests/utils/proseSignals.test.ts tests/utils/autoTranslateTargetFixtures.test.ts tests/utils/autoTranslateTarget.test.ts tests/utils/contentDetector.test.ts tests/utils/contentFilter.test.ts tests/utils/contentUnitClassifier.test.ts tests/utils/translationTarget.test.ts tests/utils/siteProfiles.test.ts",
    "test:input-page": "node scripts/serve-input-translation-test.mjs",
    "benchmark:translation": "node scripts/benchmark-translation.mjs",
    "verify": "pnpm compile && pnpm test",
    "release": "GITHUB_TOKEN=${GITHUB_TOKEN:-$(gh auth token)} release-it",
    "release:check": "node scripts/check-release-readiness.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@floating-ui/dom": "^1.7.4",
    "@wxt-dev/storage": "^1.0.1",
    "crypto-js": "^4.2.0",
    "dompurify": "^3.4.13",
    "element-plus": "2.11.3",
    "epubjs": "0.3.93",
    "franc-min": "^6.2.0",
    "onnxruntime-web": "1.29.0",
    "paddleocr": "1.2.0",
    "pdfjs-dist": "^5.4.624",
    "vue-i18n": "^11.4.8",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^11.0.1",
    "@types/crypto-js": "^4.2.2",
    "@types/webextension-polyfill": "^0.12.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.6",
    "@wxt-dev/webextension-polyfill": "^1.0.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.2",
    "release-it": "^20.0.0",
    "typescript": "^5.7.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.9",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "overrides": {
      "epubjs@0.3.93>@xmldom/xmldom": "0.8.13",
      "@vue/test-utils@2.4.6>js-beautify": "2.0.3",
      "js-beautify@2.0.3>nopt": "9.0.0",
      "basic-ftp@5.3.0": "5.3.1",
      "brace-expansion@1.1.11": "1.1.18",
      "defu@6.1.4": "6.1.5",
      "ip-address@10.1.0": "10.3.1",
      "minimatch@3.1.2": "3.1.4",
      "node-forge@1.3.1": "1.4.0",
      "picomatch@2.3.1": "2.3.2",
      "undici@7.24.5": "7.29.0"
    }
  },
  "packageManager": "pnpm@9.12.1+sha1.7084e7df42ee1d221994c2c2599277a2a937f050"
}
