{
  "git": {
    "commitMessage": "chore(release): v${version}",
    "requireCleanWorkingDir": false,
    "tagName": "v${version}"
  },
  "github": {
    "release": true,
    "releaseName": "v${version}",
    "assets": [
      ".output/OnlyTranslate-v${version}-chrome.zip"
    ]
  },
  "npm": {
    "publish": false
  },
  "hooks": {
    "before:github:release": "pnpm zip"
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": "angular",
      "infile": "CHANGELOG.md",
      "gitRawCommitsOpts": {
        "path": [
          "."
        ]
      }
    }
  }
}
